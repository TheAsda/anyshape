{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "types": ["vite/client", "node"],
    "paths": {
      "form-lib/react": ["../../src/react/index.ts"],
      "form-lib/recipes": ["../../recipes/index.ts"],
      "form-lib": ["../../src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}

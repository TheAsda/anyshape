{
  "name": "form-lib",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:react": "vitest run --project react",
    "test:recipes": "vitest run --project recipes",
    "test:watch": "vitest",
    "bench": "vitest bench --run --project 'unit (bench)' --reporter=verbose",
    "test:memory": "vitest run --config vitest.memory.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p recipes",
    "dev": "vite"
  },
  "dependencies": {},
  "peerDependencies": {
    "zod": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "5.0.2",
    "playwright": "^1.63.0",
    "ts-expect": "^1.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^5.0.2",
    "vitest-browser-react": "^2.3.0"
  }
}

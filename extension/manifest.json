{
  "manifest_version": 3,
  "name": "Form Library DevTools",
  "version": "0.1.0",
  "description": "DevTools panel for form library debugging",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
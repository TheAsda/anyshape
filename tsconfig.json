{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "vitest-browser-react", "@vitest/browser-playwright"]
  },
  "include": ["src/**/*", "test/**/*", "bench/**/*"],
  "exclude": ["node_modules"]
}
